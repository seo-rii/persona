{
  "description": "Route Bash and repo-scoped file tools through persona daemon sessions.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/persona-wrap\"",
            "timeout": 40,
            "statusMessage": "Preparing persona-backed shell command",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Read|Edit|MultiEdit|Write|NotebookEdit|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/persona-wrap\"",
            "timeout": 40,
            "statusMessage": "Routing file tools through persona view",
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Edit|MultiEdit|Write|NotebookEdit|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/persona-wrap\"",
            "timeout": 40,
            "statusMessage": "Flushing persona-backed file changes"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/persona-wrap\"",
            "timeout": 40,
            "statusMessage": "Cleaning up persona daemon session"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Read|Edit|MultiEdit|Write|NotebookEdit|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/persona-wrap\"",
            "timeout": 40,
            "statusMessage": "Saving partial persona-backed file changes"
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "matcher": "Read|Edit|MultiEdit|Write|NotebookEdit|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/persona-wrap\"",
            "timeout": 40,
            "statusMessage": "Releasing denied persona file-tool lease"
          }
        ]
      }
    ]
  }
}
