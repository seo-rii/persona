{
  "description": "Route Bash and repo-scoped file tools through persona daemon sessions.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/persona-wrap",
            "timeout": 30,
            "statusMessage": "Preparing persona-backed shell command"
          }
        ]
      },
      {
        "matcher": "Read|Edit|MultiEdit|Write|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/persona-wrap",
            "timeout": 10,
            "statusMessage": "Routing file tools through persona view"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Edit|MultiEdit|Write|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/persona-wrap",
            "timeout": 10,
            "statusMessage": "Flushing persona-backed file changes"
          }
        ]
      }
    ]
  }
}
