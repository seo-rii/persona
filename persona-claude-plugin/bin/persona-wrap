#!/usr/bin/env python3

import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time


DEFAULT_BYPASS_PREFIXES = ("git", "gh", "persona", "claude")
READ_ONLY_FILE_TOOLS = {"Read", "Glob", "Grep"}
WRITE_FILE_TOOLS = {"Edit", "MultiEdit", "Write"}
FILE_TOOLS = READ_ONLY_FILE_TOOLS | WRITE_FILE_TOOLS
SHELL_NAMES = {"bash", "sh", "zsh", "fish"}
ASSIGNMENT_RE = re.compile(r"[A-Za-z_][A-Za-z0-9_]*=.*")
DURATION_RE = re.compile(r"(?i)^([0-9]+(?:\.[0-9]+)?)(ms|s|m|h)$")


def load_event():
    try:
        return json.load(sys.stdin)
    except json.JSONDecodeError:
        return {}


def emit_pretooluse(decision, reason=None, updated_input=None):
    payload = {
        "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": decision,
        }
    }
    if reason:
        payload["hookSpecificOutput"]["permissionDecisionReason"] = reason
    if updated_input is not None:
        payload["hookSpecificOutput"]["updatedInput"] = updated_input
    json.dump(payload, sys.stdout)


def emit_posttooluse(additional_context=None):
    payload = {"hookSpecificOutput": {"hookEventName": "PostToolUse"}}
    if additional_context:
        payload["hookSpecificOutput"]["additionalContext"] = additional_context
    json.dump(payload, sys.stdout)


def tokenize(command):
    try:
        return shlex.split(command, posix=True)
    except ValueError:
        return []


def classify_tokens(tokens):
    if not tokens:
        return None

    index = 0
    while index < len(tokens) and ASSIGNMENT_RE.fullmatch(tokens[index]):
        index += 1
    if index >= len(tokens):
        return None

    token = os.path.basename(tokens[index])

    if token == "env":
        index += 1
        while index < len(tokens):
            current = tokens[index]
            if current == "--":
                index += 1
                break
            if current.startswith("-") or ASSIGNMENT_RE.fullmatch(current):
                index += 1
                continue
            break
        return classify_tokens(tokens[index:])

    if token in {"command", "builtin", "time", "noglob"}:
        return classify_tokens(tokens[index + 1 :])

    if token == "sudo":
        index += 1
        while index < len(tokens):
            current = tokens[index]
            if current == "--":
                index += 1
                break
            if current.startswith("-"):
                index += 1
                continue
            break
        return classify_tokens(tokens[index:])

    if token in SHELL_NAMES:
        for shell_index in range(index + 1, len(tokens) - 1):
            flag = tokens[shell_index]
            if flag == "--":
                break
            if flag.startswith("-") and "c" in flag[1:]:
                return classify_tokens(tokenize(tokens[shell_index + 1]))
        return token

    return token


def bypass_reason(command):
    bypass_regex = os.getenv("PERSONA_WRAP_BYPASS_REGEX", "").strip()
    if bypass_regex:
        try:
            if re.search(bypass_regex, command):
                return "Bypass persona because the command matches the configured PERSONA_WRAP_BYPASS_REGEX rule."
        except re.error:
            pass

    prefixes = split_csv(os.getenv("PERSONA_WRAP_BYPASS_PREFIXES", ""))
    if not prefixes:
        prefixes = list(DEFAULT_BYPASS_PREFIXES)
    primary = classify_tokens(tokenize(command))
    if primary not in prefixes:
        return ""
    if primary in {"git", "gh"}:
        return "Bypass persona for Git-aware shell commands because persona masks .git from child commands."
    if primary in {"persona", "claude"}:
        return "Bypass persona for direct persona or claude shell commands to avoid recursive wrapping."
    return f"Bypass persona because the command resolves to {primary}, which is configured to skip wrapping."


def split_csv(raw):
    return [item.strip() for item in raw.split(",") if item.strip()]


def repo_root(cwd):
    try:
        completed = subprocess.run(
            ["git", "-C", cwd, "rev-parse", "--show-toplevel"],
            check=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=2,
        )
    except (OSError, subprocess.SubprocessError):
        return ""
    return completed.stdout.strip()


def is_subpath(path, root):
    if not path or not root:
        return False
    try:
        return os.path.commonpath([path, root]) == root
    except ValueError:
        return False


def rel_to_root(path, root):
    return os.path.relpath(path, root)


def safe_existing_ancestor(path, root):
    probe = path
    root_real = os.path.realpath(root)
    while True:
        if os.path.lexists(probe):
            return is_subpath(os.path.realpath(probe), root_real)
        parent = os.path.dirname(probe)
        if parent == probe:
            return False
        probe = parent


def protected_path_reason(path_value, repo_dir, view_path, git_dir, patch_path):
    if not isinstance(path_value, str) or not path_value.strip():
        return ""
    candidate = os.path.abspath(path_value)
    daemon_root = os.path.join(git_dir, "persona", "daemon") if git_dir else ""
    for root in [
        os.path.join(repo_dir, ".git") if repo_dir else "",
        os.path.join(view_path, ".git") if view_path else "",
    ]:
        if root and is_subpath(candidate, os.path.abspath(root)):
            return (
                "persona-claude blocks Claude file tools from .git paths because persona masks .git inside overlay views; "
                "use git-aware commands such as git status, git diff, or git rev-parse instead."
            )
    for root in [
        daemon_root,
        patch_path,
        patch_path + ".lock" if patch_path else "",
    ]:
        if root and is_subpath(candidate, os.path.abspath(root)):
            return (
                "persona-claude blocks Claude file tools from daemon state paths; "
                "use persona daemon info, list, flush, or end instead."
            )
    return ""


def resolve_persona_bin():
    configured = os.getenv("PERSONA_WRAP_PERSONA_BIN", "").strip()
    if not configured:
        configured = os.getenv("CLAUDE_PLUGIN_OPTION_PERSONA_BIN", "").strip()
    if not configured:
        configured = "persona"

    if "/" in configured or configured.startswith("."):
        candidate = configured
        if not os.path.isabs(candidate):
            project_dir = os.getenv("CLAUDE_PROJECT_DIR", "").strip()
            if project_dir:
                candidate = os.path.join(project_dir, candidate)
            else:
                candidate = os.path.abspath(candidate)
        candidate = os.path.abspath(candidate)
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return candidate
        return ""

    if shutil.which(configured):
        return configured
    return ""


def plugin_option(name):
    return os.getenv(f"CLAUDE_PLUGIN_OPTION_{name}", "").strip()


def parse_duration_seconds(raw, option_name):
    match = DURATION_RE.fullmatch(raw.strip())
    if not match:
        raise ValueError(f"{option_name} must be a duration like 250ms, 2s, 5m, or 1h")
    magnitude = float(match.group(1))
    unit = match.group(2).lower()
    if unit == "ms":
        return magnitude / 1000.0
    if unit == "s":
        return magnitude
    if unit == "m":
        return magnitude * 60.0
    return magnitude * 3600.0


def daemon_option_args():
    args = []
    if plugin_option("DAEMON_BASE_MODE"):
        args.extend(["--base-mode", plugin_option("DAEMON_BASE_MODE")])
    if plugin_option("DAEMON_BASE_REF"):
        args.extend(["--base-ref", plugin_option("DAEMON_BASE_REF")])
    allow_dirty = plugin_option("DAEMON_ALLOW_DIRTY").lower()
    if allow_dirty:
        if allow_dirty in {"1", "true", "yes", "on"}:
            args.append("--allow-dirty")
        elif allow_dirty not in {"0", "false", "no", "off"}:
            raise ValueError("DAEMON_ALLOW_DIRTY must be one of true/false/1/0/yes/no/on/off")
    if plugin_option("DAEMON_IGNORED_MODE"):
        args.extend(["--ignored-mode", plugin_option("DAEMON_IGNORED_MODE")])
    if plugin_option("DAEMON_IGNORED_MAX"):
        raw = plugin_option("DAEMON_IGNORED_MAX")
        int(raw)
        args.extend(["--ignored-max", raw])
    if plugin_option("DAEMON_APPLY_MODE"):
        args.extend(["--apply-mode", plugin_option("DAEMON_APPLY_MODE")])
    return args


def flush_behavior():
    min_age = plugin_option("FLUSH_MIN_AGE")
    if min_age:
        parse_duration_seconds(min_age, "FLUSH_MIN_AGE")
    retry_for_raw = plugin_option("FLUSH_RETRY_FOR") or "2s"
    retry_for = parse_duration_seconds(retry_for_raw, "FLUSH_RETRY_FOR")
    retry_interval_raw = plugin_option("FLUSH_RETRY_INTERVAL_MS") or "150"
    retry_interval_ms = int(retry_interval_raw)
    if retry_interval_ms <= 0:
        raise ValueError("FLUSH_RETRY_INTERVAL_MS must be > 0")
    return min_age, retry_for, retry_interval_ms / 1000.0


def daemon_session_info(persona_bin, session_id, daemon_args, cwd):
    completed = subprocess.run(
        [persona_bin, "daemon", "info", "--session-key", session_id or "session", *daemon_args, "--json"],
        check=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        cwd=cwd,
    )
    return json.loads(completed.stdout)


def daemon_flush(persona_bin, session_id, min_age, cwd):
    args = [persona_bin, "daemon", "flush", "--session-key", session_id or "session"]
    if min_age:
        args.extend(["--min-age", min_age])
    subprocess.run(
        args,
        check=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE,
        text=True,
        cwd=cwd,
    )


def daemon_mark_dirty(persona_bin, session_id, cwd):
    subprocess.run(
        [persona_bin, "daemon", "mark-dirty", "--session-key", session_id or "session"],
        check=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE,
        text=True,
        cwd=cwd,
    )


def daemon_end(persona_bin, session_id, cwd):
    subprocess.run(
        [persona_bin, "daemon", "end", "--session-key", session_id or "session"],
        check=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE,
        text=True,
        cwd=cwd,
    )


def subprocess_error_text(err):
    if isinstance(err, subprocess.CalledProcessError):
        stderr = (err.stderr or "").strip()
        if stderr:
            return stderr
        stdout = (err.stdout or "").strip()
        if stdout:
            return stdout
    return str(err)


def selected_shell(event, tool_input):
    for candidate in (
        tool_input.get("shell"),
        event.get("shell"),
        os.getenv("CLAUDE_SHELL", "").strip(),
        os.getenv("SHELL", "").strip(),
    ):
        if isinstance(candidate, str) and candidate.strip():
            return candidate.strip()
    return "bash"


def shell_args(shell_command):
    shell_name = os.path.basename(shell_command)
    if shell_name in {"bash", "zsh", "ksh", "mksh", "fish"}:
        return ["-lc"]
    return ["-c"]


def wrapped_command(persona_bin, session_id, daemon_args, shell_command, original_command):
    shell_argv = " ".join(shlex.quote(arg) for arg in [shell_command, *shell_args(shell_command)])
    daemon_argv = " ".join(shlex.quote(arg) for arg in daemon_args)
    if daemon_argv:
        daemon_argv = " " + daemon_argv
    return (
        f"{shlex.quote(persona_bin)} daemon exec --session-key {shlex.quote(session_id or 'session')}{daemon_argv} -- "
        f"{shell_argv} {shlex.quote(original_command)}"
    )


def translated_repo_path(path_value, repo_dir, view_path, git_dir, patch_path):
    if not isinstance(path_value, str) or not path_value.strip():
        return "", False, ""
    candidate = os.path.abspath(path_value)
    denied_reason = protected_path_reason(candidate, repo_dir, view_path, git_dir, patch_path)
    if denied_reason:
        return candidate, False, denied_reason
    if is_subpath(candidate, view_path):
        if not safe_existing_ancestor(candidate, view_path):
            return candidate, False, ""
        return candidate, True, ""
    if not is_subpath(candidate, repo_dir):
        return candidate, False, ""
    if not safe_existing_ancestor(candidate, repo_dir):
        return candidate, False, ""
    return os.path.join(view_path, rel_to_root(candidate, repo_dir)), True, ""


def translated_directory_path(path_value, repo_dir, view_path, git_dir, patch_path, cwd):
    if isinstance(path_value, str) and path_value.strip():
        return translated_repo_path(path_value, repo_dir, view_path, git_dir, patch_path)
    cwd_abs = os.path.abspath(cwd)
    denied_reason = protected_path_reason(cwd_abs, repo_dir, view_path, git_dir, patch_path)
    if denied_reason:
        return cwd_abs, False, denied_reason
    if is_subpath(cwd_abs, repo_dir):
        return os.path.join(view_path, rel_to_root(cwd_abs, repo_dir)), True, ""
    return path_value, False, ""


def repo_path_for_view(path_value, repo_dir, view_path):
    if not isinstance(path_value, str) or not path_value.strip():
        return ""
    candidate = os.path.abspath(path_value)
    if not is_subpath(candidate, view_path):
        return ""
    return os.path.join(repo_dir, rel_to_root(candidate, view_path))


def rewrite_file_tool_input(tool_name, tool_input, repo_dir, view_path, git_dir, patch_path, cwd):
    updated_input = dict(tool_input)
    if tool_name in {"Read", "Edit", "MultiEdit", "Write"}:
        rewritten_path, managed, denied_reason = translated_repo_path(
            tool_input.get("file_path"), repo_dir, view_path, git_dir, patch_path
        )
        if managed:
            updated_input["file_path"] = rewritten_path
        return updated_input, managed, denied_reason
    if tool_name in {"Glob", "Grep"}:
        rewritten_path, managed, denied_reason = translated_directory_path(
            tool_input.get("path"), repo_dir, view_path, git_dir, patch_path, cwd
        )
        if managed:
            updated_input["path"] = rewritten_path
        return updated_input, managed, denied_reason
    return updated_input, False, ""


def managed_write_target(tool_name, tool_input, repo_dir, view_path, git_dir, patch_path):
    if tool_name not in WRITE_FILE_TOOLS:
        return False
    _, managed, _ = translated_repo_path(tool_input.get("file_path"), repo_dir, view_path, git_dir, patch_path)
    return managed


def managed_tool_context(tool_name, tool_input, repo_dir, view_path, cwd):
    if tool_name in {"Read", "Edit", "MultiEdit", "Write"}:
        repo_path = repo_path_for_view(tool_input.get("file_path"), repo_dir, view_path)
        if repo_path:
            return (
                f"This {tool_name} call used persona view path {os.path.abspath(tool_input.get('file_path'))}. "
                f"Treat it as repository path {repo_path}."
            )
        return ""
    if tool_name in {"Glob", "Grep"}:
        search_root = tool_input.get("path")
        if not isinstance(search_root, str) or not search_root.strip():
            search_root = os.path.abspath(cwd)
        repo_path = repo_path_for_view(search_root, repo_dir, view_path)
        if repo_path:
            return (
                f"This {tool_name} call searched persona view path {os.path.abspath(search_root)}. "
                f"Treat matching paths under {view_path} as repository paths under {repo_dir}; "
                f"the search root corresponds to {repo_path}."
            )
    return ""


def persona_not_found_reason():
    return "persona binary not found; configure the plugin PERSONA_BIN option or set PERSONA_WRAP_PERSONA_BIN."


def handle_pretooluse(event):
    tool_name = event.get("tool_name")
    tool_input = event.get("tool_input", {})
    cwd = event.get("cwd") or os.getcwd()
    session_id = event.get("session_id", "")

    if tool_name == "Bash":
        command = tool_input.get("command", "")
        if not isinstance(command, str) or not command.strip():
            return 0
        bypass = bypass_reason(command)
        if bypass:
            emit_pretooluse("allow", bypass)
            return 0

        repo_dir = repo_root(cwd)
        if not repo_dir:
            return 0

        persona_bin = resolve_persona_bin()
        if not persona_bin:
            emit_pretooluse("deny", persona_not_found_reason())
            return 0

        try:
            daemon_args = daemon_option_args()
        except ValueError as err:
            emit_pretooluse("deny", f"invalid persona daemon plugin option: {err}")
            return 0

        updated_input = dict(tool_input)
        shell_command = selected_shell(event, tool_input)
        updated_input["command"] = wrapped_command(persona_bin, session_id, daemon_args, shell_command, command)
        emit_pretooluse("allow", "Run the Bash command through persona.", updated_input)
        return 0

    if tool_name not in FILE_TOOLS:
        return 0

    repo_dir = repo_root(cwd)
    if not repo_dir:
        return 0

    persona_bin = resolve_persona_bin()
    if not persona_bin:
        emit_pretooluse("deny", persona_not_found_reason())
        return 0

    try:
        daemon_args = daemon_option_args()
    except ValueError as err:
        emit_pretooluse("deny", f"invalid persona daemon plugin option: {err}")
        return 0

    try:
        info = daemon_session_info(persona_bin, session_id, daemon_args, cwd)
    except (OSError, subprocess.SubprocessError, json.JSONDecodeError) as err:
        emit_pretooluse("deny", f"persona daemon session lookup failed: {subprocess_error_text(err)}")
        return 0

    view_path = info.get("view_path", "")
    git_dir = info.get("git_dir", "")
    patch_path = info.get("patch_path", "")
    updated_input, managed, denied_reason = rewrite_file_tool_input(
        tool_name, tool_input, repo_dir, view_path, git_dir, patch_path, cwd
    )
    if denied_reason:
        emit_pretooluse("deny", denied_reason)
        return 0
    if tool_name in WRITE_FILE_TOOLS and not managed:
        emit_pretooluse(
            "deny",
            "persona-claude only permits direct file writes for paths inside the current repository or its daemon-backed view.",
        )
        return 0
    if managed:
        if tool_name in WRITE_FILE_TOOLS:
            try:
                daemon_mark_dirty(persona_bin, session_id, cwd)
            except (OSError, subprocess.SubprocessError) as err:
                emit_pretooluse("deny", f"persona daemon dirty-mark failed: {subprocess_error_text(err)}")
                return 0
        emit_pretooluse("allow", "Route the file tool through persona's daemon-backed view.", updated_input)
    return 0


def handle_posttooluse(event):
    tool_name = event.get("tool_name")
    if tool_name not in FILE_TOOLS:
        return 0

    cwd = event.get("cwd") or os.getcwd()
    session_id = event.get("session_id", "")
    repo_dir = repo_root(cwd)
    if not repo_dir:
        return 0

    persona_bin = resolve_persona_bin()
    if not persona_bin:
        print(persona_not_found_reason(), file=sys.stderr)
        return 1

    try:
        daemon_args = daemon_option_args()
    except ValueError as err:
        print(f"invalid persona daemon plugin option: {err}", file=sys.stderr)
        return 1

    try:
        flush_min_age, flush_retry_for, flush_retry_interval = flush_behavior()
    except ValueError as err:
        print(f"invalid persona flush plugin option: {err}", file=sys.stderr)
        return 1

    try:
        info = daemon_session_info(persona_bin, session_id, daemon_args, cwd)
    except (OSError, subprocess.SubprocessError, json.JSONDecodeError) as err:
        print(f"persona daemon session lookup failed: {subprocess_error_text(err)}", file=sys.stderr)
        return 1

    managed_context = managed_tool_context(tool_name, event.get("tool_input", {}), repo_dir, info.get("view_path", ""), cwd)

    if tool_name not in WRITE_FILE_TOOLS:
        if managed_context:
            emit_posttooluse(managed_context)
        return 0

    if not managed_write_target(
        tool_name,
        event.get("tool_input", {}),
        repo_dir,
        info.get("view_path", ""),
        info.get("git_dir", ""),
        info.get("patch_path", ""),
    ):
        return 0

    deadline = time.monotonic() + flush_retry_for
    while True:
        try:
            daemon_flush(persona_bin, session_id, flush_min_age, cwd)
            break
        except (OSError, subprocess.SubprocessError) as err:
            err_text = subprocess_error_text(err)
            if "still busy" in err_text and time.monotonic() < deadline:
                time.sleep(flush_retry_interval)
                continue
            print(f"persona daemon flush failed: {err_text}", file=sys.stderr)
            return 1
    if managed_context:
        suffix = " persona flushed the daemon-backed file-tool change into the session patch."
        if flush_min_age:
            suffix = " persona flushed or deferred the daemon-backed file-tool change according to FLUSH_MIN_AGE."
        emit_posttooluse(managed_context + suffix)
        return 0
    if flush_min_age:
        emit_posttooluse("persona flushed or deferred the daemon-backed file-tool change according to FLUSH_MIN_AGE.")
        return 0
    emit_posttooluse("persona flushed the daemon-backed file-tool change into the session patch.")
    return 0


def handle_session_end(event):
    cwd = event.get("cwd") or os.getcwd()
    session_id = event.get("session_id", "")
    if not repo_root(cwd):
        return 0

    persona_bin = resolve_persona_bin()
    if not persona_bin:
        return 0
    try:
        daemon_end(persona_bin, session_id, cwd)
    except (OSError, subprocess.SubprocessError) as err:
        print(f"persona daemon end failed during SessionEnd: {subprocess_error_text(err)}", file=sys.stderr)
    return 0


def main():
    event = load_event()
    hook_name = event.get("hook_event_name")
    if hook_name == "PreToolUse":
        return handle_pretooluse(event)
    if hook_name == "PostToolUse":
        return handle_posttooluse(event)
    if hook_name == "SessionEnd":
        return handle_session_end(event)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
