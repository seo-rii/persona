#!/usr/bin/env python3

import hashlib
import json
import os
import re
import shlex
import shutil
import stat
import subprocess
import sys
import tempfile
import time


DEFAULT_BYPASS_PREFIXES = ("git", "gh", "persona", "claude")
READ_ONLY_FILE_TOOLS = {"Read", "Glob", "Grep"}
WRITE_FILE_TOOLS = {"Edit", "MultiEdit", "Write", "NotebookEdit"}
FILE_TOOLS = READ_ONLY_FILE_TOOLS | WRITE_FILE_TOOLS
DURATION_RE = re.compile(r"(?i)^([0-9]+(?:\.[0-9]+)?)(ms|s|m|h)$")


def load_event():
    event = json.load(sys.stdin)
    if not isinstance(event, dict):
        raise ValueError("persona hook input must be a JSON object")
    return event


def emit_pretooluse(decision=None, reason=None, updated_input=None):
    payload = {
        "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
        }
    }
    if decision:
        payload["hookSpecificOutput"]["permissionDecision"] = decision
    if reason and decision:
        payload["hookSpecificOutput"]["permissionDecisionReason"] = reason
    elif reason:
        payload["hookSpecificOutput"]["additionalContext"] = reason
    if updated_input is not None:
        payload["hookSpecificOutput"]["updatedInput"] = updated_input
    json.dump(payload, sys.stdout)


def emit_posttooluse(additional_context=None, hook_name="PostToolUse", warning=False):
    payload = {"hookSpecificOutput": {"hookEventName": hook_name}}
    if additional_context and hook_name != "PermissionDenied":
        payload["hookSpecificOutput"]["additionalContext"] = additional_context
    if warning:
        payload["systemMessage"] = additional_context
    json.dump(payload, sys.stdout)


def tokenize(command):
    try:
        lexer = shlex.shlex(command, posix=True, punctuation_chars="();<>|&")
        lexer.whitespace_split = True
        lexer.commenters = ""
        return list(lexer)
    except ValueError:
        return []


def classify_tokens(tokens):
    # Only the literal executable qualifies. Wrappers such as env, sudo and
    # nested shells stay inside persona; interpreting their options is unsafe.
    return os.path.basename(tokens[0]) if tokens else None


def is_simple_shell_command(command):
    # This deliberately recognizes a small literal subset, not shell syntax.
    # Quoted/escaped punctuation is data; active expansions and operators are
    # never permitted to take the original-checkout bypass.
    quote = ""
    escaped = False
    for char in command:
        if escaped:
            if char == "\n":
                return False
            escaped = False
            continue
        if quote == "'":
            if char == "'":
                quote = ""
            continue
        if char == "\\":
            escaped = True
            continue
        if quote == '"':
            if char == '"':
                quote = ""
            elif char in "$`":
                return False
            continue
        if char in "'\"":
            quote = char
        elif char in ";&|<>(){}$`#*?[]~\n\r":
            return False
    return not quote and not escaped and bool(tokenize(command))


def bypass_decision(command):
    matched_regex = False
    bypass_regex = os.getenv("PERSONA_WRAP_BYPASS_REGEX", "").strip()
    if bypass_regex:
        try:
            if re.search(bypass_regex, command):
                matched_regex = True
        except re.error:
            pass

    prefixes = split_csv(os.getenv("PERSONA_WRAP_BYPASS_PREFIXES", ""))
    if not prefixes:
        prefixes = list(DEFAULT_BYPASS_PREFIXES)
    primary = classify_tokens(tokenize(command))
    if primary not in prefixes and not matched_regex:
        return "", ""
    if not is_simple_shell_command(command):
        return "", (
            "persona-claude cannot bypass a shell command containing operators, redirection, or expansion. "
            "Run the Git/persona/Claude command separately from commands that edit files."
        )
    if matched_regex:
        return "Bypass persona for a single literal command matching PERSONA_WRAP_BYPASS_REGEX.", ""
    if primary in {"git", "gh"}:
        return "Bypass persona for Git-aware shell commands because persona masks .git from child commands.", ""
    if primary in {"persona", "claude"}:
        return "Bypass persona for direct persona or claude shell commands to avoid recursive wrapping.", ""
    return f"Bypass persona for the single literal command {primary}, configured to skip wrapping.", ""


def split_csv(raw):
    return [item.strip() for item in raw.split(",") if item.strip()]


def repo_root(cwd):
    try:
        completed = subprocess.run(
            ["git", "-C", cwd, "rev-parse", "--show-toplevel"],
            check=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=2,
            env={**{key: value for key, value in os.environ.items() if not key.startswith("GIT_")}, "LC_ALL": "C"},
        )
    except subprocess.CalledProcessError as err:
        if err.returncode == 128 and "not a git repository" in (err.stderr or ""):
            return ""
        raise
    return completed.stdout.strip()


def is_subpath(path, root):
    if not path or not root:
        return False
    try:
        return os.path.commonpath([path, root]) == root
    except ValueError:
        return False


def rel_to_root(path, root):
    return os.path.relpath(path, root)


def safe_existing_ancestor(path, root):
    probe = path
    root_real = os.path.realpath(root)
    while True:
        if os.path.lexists(probe):
            return is_subpath(os.path.realpath(probe), root_real)
        parent = os.path.dirname(probe)
        if parent == probe:
            return False
        probe = parent


def protected_path_reason(path_value, repo_dir, view_path, git_dir, patch_path):
    if not isinstance(path_value, str) or not path_value.strip():
        return ""
    candidate = os.path.abspath(path_value)
    candidates = {candidate, os.path.realpath(candidate)}
    daemon_root = os.path.join(git_dir, "persona", "daemon") if git_dir else ""
    git_reason = (
        "persona-claude blocks Claude file tools from .git paths because persona masks .git inside overlay views; "
        "use git-aware commands such as git status, git diff, or git rev-parse instead."
    )
    daemon_reason = (
        "persona-claude blocks Claude file tools from daemon state paths; "
        "use persona daemon info, list, flush, or end instead."
    )
    view_roots = {os.path.abspath(view_path), os.path.realpath(view_path)} if view_path else set()
    for root, reason, contains_view in [
        (os.path.join(view_path, ".git") if view_path else "", git_reason, False),
        (daemon_root, daemon_reason, True),
        (lease_directory_path(), daemon_reason, False),
        (patch_path, daemon_reason, False),
        (patch_path + ".lock" if patch_path else "", daemon_reason, False),
        (os.path.join(repo_dir, ".git") if repo_dir else "", git_reason, True),
        (git_dir, git_reason, True),
    ]:
        if root and any(
            is_subpath(item, root_path) and not (
                contains_view and any(is_subpath(item, view_root) for view_root in view_roots)
            )
            for item in candidates
            for root_path in {os.path.abspath(root), os.path.realpath(root)}
        ):
            return reason
    return ""


def resolve_persona_bin():
    configured = os.getenv("PERSONA_WRAP_PERSONA_BIN", "").strip()
    if not configured:
        configured = os.getenv("CLAUDE_PLUGIN_OPTION_PERSONA_BIN", "").strip()
    if not configured:
        configured = "persona"

    if "/" in configured or configured.startswith("."):
        candidate = configured
        if not os.path.isabs(candidate):
            project_dir = os.getenv("CLAUDE_PROJECT_DIR", "").strip()
            if project_dir:
                candidate = os.path.join(project_dir, candidate)
            else:
                candidate = os.path.abspath(candidate)
        candidate = os.path.abspath(candidate)
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return candidate
        return ""

    if shutil.which(configured):
        return configured
    return ""


def plugin_option(name):
    return os.getenv(f"CLAUDE_PLUGIN_OPTION_{name}", "").strip()


def parse_duration_seconds(raw, option_name):
    match = DURATION_RE.fullmatch(raw.strip())
    if not match:
        raise ValueError(f"{option_name} must be a duration like 250ms, 2s, 5m, or 1h")
    magnitude = float(match.group(1))
    unit = match.group(2).lower()
    if unit == "ms":
        return magnitude / 1000.0
    if unit == "s":
        return magnitude
    if unit == "m":
        return magnitude * 60.0
    return magnitude * 3600.0


def daemon_option_args():
    args = ["--base-mode", plugin_option("DAEMON_BASE_MODE") or "worktree"]
    if plugin_option("DAEMON_BASE_REF"):
        args.extend(["--base-ref", plugin_option("DAEMON_BASE_REF")])
    allow_dirty = plugin_option("DAEMON_ALLOW_DIRTY").lower()
    if allow_dirty:
        if allow_dirty in {"1", "true", "yes", "on"}:
            args.append("--allow-dirty")
        elif allow_dirty not in {"0", "false", "no", "off"}:
            raise ValueError("DAEMON_ALLOW_DIRTY must be one of true/false/1/0/yes/no/on/off")
    if plugin_option("DAEMON_IGNORED_MODE"):
        args.extend(["--ignored-mode", plugin_option("DAEMON_IGNORED_MODE")])
    if plugin_option("DAEMON_IGNORED_MAX"):
        raw = plugin_option("DAEMON_IGNORED_MAX")
        int(raw)
        args.extend(["--ignored-max", raw])
    if plugin_option("DAEMON_APPLY_MODE"):
        args.extend(["--apply-mode", plugin_option("DAEMON_APPLY_MODE")])
    return args


def daemon_timeout():
    timeout = parse_duration_seconds(os.getenv("PERSONA_WRAP_DAEMON_TIMEOUT", "30s"), "PERSONA_WRAP_DAEMON_TIMEOUT")
    if timeout <= 0:
        raise ValueError("PERSONA_WRAP_DAEMON_TIMEOUT must be positive")
    return timeout


def daemon_call(args, cwd, timeout=None):
    return subprocess.run(
        args,
        check=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        cwd=cwd,
        timeout=daemon_timeout() if timeout is None else timeout,
    )


def daemon_acquire(persona_bin, session_id, daemon_args, cwd):
    completed = daemon_call(
        [persona_bin, "daemon", "acquire", "--session-key", session_id, *daemon_args,
         "--owner-pid", str(lease_owner_pid()), "--json"], cwd
    )
    response = json.loads(completed.stdout)
    info = response.get("session")
    lease_id = response.get("lease_id")
    if not isinstance(info, dict) or not isinstance(lease_id, str) or not lease_id:
        raise ValueError("daemon acquire returned no session or lease identity")
    if not isinstance(info.get("view_generation"), int) or info["view_generation"] <= 0:
        raise ValueError("daemon acquire returned no view generation")
    return info, lease_id


def daemon_release(persona_bin, session_id, lease_id, generation, cwd):
    return daemon_call(
        [persona_bin, "daemon", "release", "--session-key", session_id,
         "--lease-id", lease_id, "--view-generation", str(generation)], cwd
    )


def daemon_end(persona_bin, session_id, cwd, timeout=None):
    daemon_call([persona_bin, "daemon", "end", "--session-key", session_id], cwd, timeout)


def subprocess_error_text(err):
    if isinstance(err, subprocess.CalledProcessError):
        stderr = (err.stderr or "").strip()
        if stderr:
            return stderr
        stdout = (err.stdout or "").strip()
        if stdout:
            return stdout
    return str(err)


def selected_shell(event, tool_input):
    for candidate in (
        tool_input.get("shell"),
        event.get("shell"),
        os.getenv("CLAUDE_SHELL", "").strip(),
        os.getenv("SHELL", "").strip(),
    ):
        if isinstance(candidate, str) and candidate.strip():
            return candidate.strip()
    return "bash"


def shell_args(shell_command):
    shell_name = os.path.basename(shell_command)
    if shell_name in {"bash", "zsh", "ksh", "mksh", "fish"}:
        return ["-lc"]
    return ["-c"]


def wrapped_command(persona_bin, session_id, daemon_args, shell_command, original_command):
    shell_argv = " ".join(shlex.quote(arg) for arg in [shell_command, *shell_args(shell_command)])
    daemon_argv = " ".join(shlex.quote(arg) for arg in daemon_args)
    if daemon_argv:
        daemon_argv = " " + daemon_argv
    return (
        f"{shlex.quote(persona_bin)} daemon exec --session-key {shlex.quote(session_id)}{daemon_argv} -- "
        f"{shell_argv} {shlex.quote(original_command)}"
    )


def translated_repo_path(path_value, repo_dir, view_path, git_dir, patch_path, cwd=None):
    if not isinstance(path_value, str) or not path_value.strip():
        return "", False, ""
    candidate = os.path.abspath(os.path.join(cwd or os.getcwd(), path_value))
    denied_reason = protected_path_reason(candidate, repo_dir, view_path, git_dir, patch_path)
    if denied_reason:
        return candidate, False, denied_reason
    if is_subpath(candidate, view_path):
        translated = candidate
    elif is_subpath(candidate, repo_dir):
        if not safe_existing_ancestor(candidate, repo_dir):
            return candidate, False, "persona-claude refuses a repository path that resolves outside the repository."
        translated = os.path.join(view_path, rel_to_root(candidate, repo_dir))
    else:
        return candidate, False, ""
    denied_reason = protected_path_reason(translated, repo_dir, view_path, git_dir, patch_path)
    if denied_reason:
        return translated, False, denied_reason
    if not safe_existing_ancestor(translated, view_path):
        return translated, False, "persona-claude refuses a view path or symlink that resolves outside the daemon-backed view."
    return translated, True, ""


def translated_directory_path(path_value, repo_dir, view_path, git_dir, patch_path, cwd):
    if isinstance(path_value, str) and path_value.strip():
        return translated_repo_path(path_value, repo_dir, view_path, git_dir, patch_path, cwd)
    return translated_repo_path(os.path.abspath(cwd), repo_dir, view_path, git_dir, patch_path, cwd)


def repo_path_for_view(path_value, repo_dir, view_path):
    if not isinstance(path_value, str) or not path_value.strip():
        return ""
    candidate = os.path.abspath(path_value)
    if not is_subpath(candidate, view_path):
        return ""
    return os.path.join(repo_dir, rel_to_root(candidate, view_path))


def rewrite_file_tool_input(tool_name, tool_input, repo_dir, view_path, git_dir, patch_path, cwd):
    updated_input = dict(tool_input)
    if tool_name in {"Read"} | WRITE_FILE_TOOLS:
        path_key = "notebook_path" if tool_name == "NotebookEdit" else "file_path"
        rewritten_path, managed, denied_reason = translated_repo_path(
            tool_input.get(path_key), repo_dir, view_path, git_dir, patch_path, cwd
        )
        if managed:
            updated_input[path_key] = rewritten_path
        return updated_input, managed, denied_reason
    if tool_name in {"Glob", "Grep"}:
        rewritten_path, managed, denied_reason = translated_directory_path(
            tool_input.get("path"), repo_dir, view_path, git_dir, patch_path, cwd
        )
        if managed:
            updated_input["path"] = rewritten_path
        return updated_input, managed, denied_reason
    return updated_input, False, ""


def managed_tool_context(tool_name, tool_input, repo_dir, view_path, cwd):
    if tool_name in {"Read"} | WRITE_FILE_TOOLS:
        path_key = "notebook_path" if tool_name == "NotebookEdit" else "file_path"
        repo_path = repo_path_for_view(tool_input.get(path_key), repo_dir, view_path)
        if repo_path:
            return (
                f"This {tool_name} call used persona view path {os.path.abspath(tool_input[path_key])}. "
                f"Treat it as repository path {repo_path}."
            )
        return ""
    if tool_name in {"Glob", "Grep"}:
        search_root = tool_input.get("path")
        if not isinstance(search_root, str) or not search_root.strip():
            search_root = os.path.abspath(cwd)
        repo_path = repo_path_for_view(search_root, repo_dir, view_path)
        if repo_path:
            return (
                f"This {tool_name} call searched persona view path {os.path.abspath(search_root)}. "
                f"Treat matching paths under {view_path} as repository paths under {repo_dir}; "
                f"the search root corresponds to {repo_path}."
            )
    return ""


def persona_not_found_reason():
    return "persona binary not found; configure the plugin PERSONA_BIN option or set PERSONA_WRAP_PERSONA_BIN."


def session_identity(event):
    session_id = event.get("session_id")
    if not isinstance(session_id, str) or not session_id.strip():
        raise ValueError("persona-claude requires a nonempty Claude session_id; refusing to share a fallback session")
    return session_id


def lease_owner_pid():
    configured = os.getenv("PERSONA_WRAP_OWNER_PID", "").strip()
    if configured:
        owner = int(configured)
        if owner <= 1 or owner == os.getpid():
            raise ValueError("PERSONA_WRAP_OWNER_PID must identify a live long-lived Claude owner process")
        os.kill(owner, 0)
        return owner
    owner = os.getppid()
    visited = set()
    while owner > 1 and owner not in visited:
        visited.add(owner)
        with open(f"/proc/{owner}/cmdline", "rb") as process:
            argv = process.read(65536).split(b"\0")
        executable = os.path.basename(os.fsdecode(argv[0]))
        node_cli = (
            executable in {"node", "nodejs", "bun"} and len(argv) > 1
            and "claude-code" in os.fsdecode(argv[1]).split(os.sep)
            and os.path.basename(os.fsdecode(argv[1])) == "cli.js"
        )
        if executable == "claude" or node_cli:
            os.kill(owner, 0)
            return owner
        with open(f"/proc/{owner}/stat", encoding="utf-8") as process:
            # comm may itself contain spaces and parentheses.
            fields = process.read(65536).rsplit(")", 1)[1].split()
        owner = int(fields[1])
    raise ValueError("persona-claude could not find a live Claude ancestor for the file-tool lease")


def lease_record_name(event, repo_dir):
    tool_id = event.get("tool_use_id")
    if not isinstance(tool_id, str) or not tool_id.strip():
        raise ValueError("persona-claude requires tool_use_id to track the file-tool lease")
    identity = json.dumps([os.path.realpath(repo_dir), session_identity(event), tool_id], ensure_ascii=True)
    return hashlib.sha256(identity.encode("utf-8")).hexdigest() + ".json"


def lease_directory_path():
    directory = os.getenv("PERSONA_WRAP_LEASE_DIR", "").strip()
    if not directory:
        directory = os.path.join(tempfile.gettempdir(), f"persona-claude-{os.getuid()}")
    return directory


def open_lease_directory():
    directory = lease_directory_path()
    try:
        os.mkdir(directory, 0o700)
    except FileExistsError:
        pass
    fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    info = os.fstat(fd)
    if info.st_uid != os.getuid() or info.st_mode & 0o077:
        os.close(fd)
        raise ValueError("persona hook lease directory must be owned by the current user with mode 0700")
    return fd


def write_private_record(directory, name, record, replace=False):
    temporary = ".tmp-" + os.urandom(16).hex()
    try:
        fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
                     0o600, dir_fd=directory)
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            json.dump(record, stream)
            stream.flush()
            os.fsync(stream.fileno())
        if replace:
            os.replace(temporary, name, src_dir_fd=directory, dst_dir_fd=directory)
        else:
            # A repeated tool-use ID must never overwrite a live lease record.
            os.link(temporary, name, src_dir_fd=directory, dst_dir_fd=directory, follow_symlinks=False)
            os.unlink(temporary, dir_fd=directory)
        os.fsync(directory)
    finally:
        try:
            os.unlink(temporary, dir_fd=directory)
        except FileNotFoundError:
            pass


def read_private_record(directory, name):
    try:
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK, dir_fd=directory)
    except FileNotFoundError:
        return None
    with os.fdopen(fd, "r", encoding="utf-8") as stream:
        info = os.fstat(stream.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077 or info.st_size > 65536:
            raise ValueError("invalid persona hook private record")
        record = json.load(stream)
    if not isinstance(record, dict):
        raise ValueError("invalid persona hook private record")
    return record


def save_lease_record(event, repo_dir, record):
    directory = open_lease_directory()
    try:
        write_private_record(directory, lease_record_name(event, repo_dir), record)
    finally:
        os.close(directory)


def read_lease_record(event, repo_dir):
    directory = open_lease_directory()
    try:
        record = read_private_record(directory, lease_record_name(event, repo_dir))
        if record is None:
            return None
        if not isinstance(record, dict) or record.get("session_id") != session_identity(event) or record.get("tool_name") != event.get("tool_name"):
            raise ValueError("persona hook lease record identity mismatch")
        return record
    finally:
        os.close(directory)


def remove_lease_record(event, repo_dir):
    directory = open_lease_directory()
    try:
        os.unlink(lease_record_name(event, repo_dir), dir_fd=directory)
        os.fsync(directory)
    finally:
        os.close(directory)


def session_registry_prefix(session_id):
    return "repo-" + hashlib.sha256(session_id.encode("utf-8")).hexdigest() + "-"


def session_registry_name(session_id, repo_dir):
    return session_registry_prefix(session_id) + hashlib.sha256(os.fsencode(os.path.realpath(repo_dir))).hexdigest() + ".json"


def register_session_repository(session_id, repo_dir, persona_bin):
    directory = open_lease_directory()
    try:
        write_private_record(directory, session_registry_name(session_id, repo_dir), {
            "session_id": session_id,
            "repo_dir": os.path.realpath(repo_dir),
            "persona_bin": os.path.abspath(shutil.which(persona_bin) or persona_bin),
        }, replace=True)
    finally:
        os.close(directory)


def registered_session_repositories(session_id):
    directory = open_lease_directory()
    records, errors = [], []
    prefix = session_registry_prefix(session_id)
    try:
        for name in sorted(os.listdir(directory)):
            if not re.fullmatch(re.escape(prefix) + r"[0-9a-f]{64}\.json", name):
                continue
            try:
                record = read_private_record(directory, name)
                if record is None:
                    continue
                repo_dir = record.get("repo_dir")
                persona_bin = record.get("persona_bin")
                if (record.get("session_id") != session_id or not isinstance(repo_dir, str)
                        or not os.path.isabs(repo_dir) or not isinstance(persona_bin, str)
                        or not os.path.isabs(persona_bin) or session_registry_name(session_id, repo_dir) != name):
                    raise ValueError("repository registration identity mismatch")
                records.append(record)
            except (OSError, ValueError) as err:
                errors.append(f"{os.path.join(lease_directory_path(), name)}: {err}")
    finally:
        os.close(directory)
    return records, errors


def remove_session_registration(session_id, repo_dir):
    directory = open_lease_directory()
    try:
        os.unlink(session_registry_name(session_id, repo_dir), dir_fd=directory)
        os.fsync(directory)
    finally:
        os.close(directory)


def find_tool_lease(event):
    session_id = session_identity(event)
    registrations, errors = registered_session_repositories(session_id)
    matches = []
    for registration in registrations:
        record = read_lease_record(event, registration["repo_dir"])
        if record is not None:
            matches.append((registration["repo_dir"], record.get("persona_bin", registration["persona_bin"]), record))
    if len(matches) > 1:
        raise ValueError("file-tool identity matches multiple repository leases; keep the records for recovery")
    if matches:
        return matches[0]
    # Older plugin versions did not register repositories. Retain their exact
    # per-repository lookup, but never redirect a recorded lease to a new cwd.
    cwd = event.get("cwd") or os.getcwd()
    repo_dir = repo_root(cwd)
    record = read_lease_record(event, repo_dir) if repo_dir else None
    if record is not None:
        return repo_dir, resolve_persona_bin(), record
    if errors:
        raise ValueError("cannot locate file-tool lease: " + "; ".join(errors))
    return None


def handle_pretooluse(event):
    tool_name = event.get("tool_name")
    tool_input = event.get("tool_input", {})
    cwd = event.get("cwd") or os.getcwd()
    repo_dir = repo_root(cwd)
    if not repo_dir or tool_name not in FILE_TOOLS | {"Bash"}:
        return 0
    try:
        session_id = session_identity(event)
    except ValueError as err:
        emit_pretooluse("deny", str(err))
        return 0

    if tool_name == "Bash":
        command = tool_input.get("command", "")
        if not isinstance(command, str) or not command.strip():
            return 0
        bypass, denied_reason = bypass_decision(command)
        if denied_reason:
            emit_pretooluse("deny", denied_reason)
            return 0
        if bypass:
            emit_pretooluse(reason=bypass)
            return 0

        persona_bin = resolve_persona_bin()
        if not persona_bin:
            emit_pretooluse("deny", persona_not_found_reason())
            return 0

        try:
            daemon_args = daemon_option_args()
            register_session_repository(session_id, repo_dir, persona_bin)
        except ValueError as err:
            emit_pretooluse("deny", f"invalid persona daemon plugin option: {err}")
            return 0

        updated_input = dict(tool_input)
        shell_command = selected_shell(event, tool_input)
        updated_input["command"] = wrapped_command(persona_bin, session_id, daemon_args, shell_command, command)
        emit_pretooluse(reason="Run the Bash command through persona; Claude's normal permission policy still applies.", updated_input=updated_input)
        return 0

    if tool_name not in FILE_TOOLS:
        return 0

    persona_bin = resolve_persona_bin()
    if not persona_bin:
        emit_pretooluse("deny", persona_not_found_reason())
        return 0

    try:
        daemon_args = daemon_option_args()
        lease_record_name(event, repo_dir)
        register_session_repository(session_id, repo_dir, persona_bin)
    except ValueError as err:
        emit_pretooluse("deny", f"invalid persona daemon plugin option: {err}")
        return 0

    try:
        info, lease_id = daemon_acquire(persona_bin, session_id, daemon_args, cwd)
    except (OSError, subprocess.SubprocessError, ValueError) as err:
        emit_pretooluse("deny", f"persona daemon lease acquisition failed: {subprocess_error_text(err)}")
        return 0

    view_path = info.get("view_path", "")
    git_dir = info.get("git_dir", "")
    patch_path = info.get("patch_path", "")
    updated_input, managed, denied_reason = rewrite_file_tool_input(
        tool_name, tool_input, repo_dir, view_path, git_dir, patch_path, cwd
    )
    if tool_name in WRITE_FILE_TOOLS and not managed:
        denied_reason = denied_reason or (
            "persona-claude only permits direct file writes for paths inside the current repository or its daemon-backed view."
        )
    try:
        save_lease_record(event, repo_dir, {"session_id": session_id, "tool_name": tool_name,
                                         "lease_id": lease_id, "session": info,
                                         "persona_bin": os.path.abspath(shutil.which(persona_bin) or persona_bin),
                                         "context": managed_tool_context(tool_name, updated_input, repo_dir, view_path, cwd)})
    except (OSError, ValueError) as err:
        reason = f"persona could not record the file-tool lease: {subprocess_error_text(err)}"
        try:
            daemon_release(persona_bin, session_id, lease_id, info["view_generation"], cwd)
        except (OSError, subprocess.SubprocessError, ValueError) as release_err:
            reason += f"; lease cleanup failed: {subprocess_error_text(release_err)}"
        emit_pretooluse("deny", reason)
        return 0
    if denied_reason or not managed:
        try:
            daemon_release(persona_bin, session_id, lease_id, info["view_generation"], cwd)
            remove_lease_record(event, repo_dir)
        except (OSError, subprocess.SubprocessError, ValueError) as err:
            denied_reason = (denied_reason or "File tool routing failed.") + (
                f" Lease cleanup failed: {subprocess_error_text(err)}; the lease record is retained for retry."
            )
        if denied_reason:
            emit_pretooluse("deny", denied_reason)
        return 0
    emit_pretooluse(reason="Route the file tool through persona's leased daemon-backed view; Claude's normal permission policy still applies.",
                    updated_input=updated_input)
    return 0


def handle_posttooluse(event):
    tool_name = event.get("tool_name")
    if tool_name not in FILE_TOOLS:
        return 0

    hook_name = event.get("hook_event_name", "PostToolUse")
    saved = False
    try:
        session_id = session_identity(event)
        found = find_tool_lease(event)
        if found is None:
            if tool_name in WRITE_FILE_TOOLS and hook_name != "PermissionDenied":
                raise ValueError("file-tool lease record is missing; the change has not been confirmed saved")
            return 0
        repo_dir, persona_bin, record = found
        if not persona_bin:
            raise ValueError(persona_not_found_reason())
        # Release uses the generation acquired before the tool ran. Never look
        # up a replacement view after a daemon restart and flush that instead.
        daemon_release(persona_bin, session_id, record["lease_id"], record["session"]["view_generation"], repo_dir)
        saved = True
        remove_lease_record(event, repo_dir)
    except (OSError, subprocess.SubprocessError, ValueError, KeyError, TypeError) as err:
        if saved:
            message = (
                f"persona durably flushed the patch, but could not finish local lease-record cleanup: {subprocess_error_text(err)}. "
                "Inspect the remaining record and daemon state before retrying that tool-use ID."
            )
        else:
            message = (
                f"persona has NOT confirmed this file-tool change saved: {subprocess_error_text(err)}. "
                "Keep any remaining lease record for recovery. Do not end, prune, or discard this session; "
                "inspect persona daemon info/list and resolve the recorded release before continuing."
            )
        emit_posttooluse(message, hook_name, warning=True)
        return 0
    context = record.get("context", "")
    suffix = "persona released the file-tool lease and durably flushed the session patch."
    if hook_name == "PostToolUseFailure":
        suffix += " The tool reported failure; any partial file changes were included in that flush."
    emit_posttooluse((context + " " + suffix).strip(), hook_name)
    return 0


def handle_session_end(event):
    session_id = session_identity(event)
    registrations, errors = registered_session_repositories(session_id)
    if not registrations:
        # Compatibility for sessions opened before repository registration.
        repo_dir = repo_root(event.get("cwd") or os.getcwd())
        persona_bin = resolve_persona_bin()
        if repo_dir and persona_bin:
            registrations.append({"repo_dir": repo_dir, "persona_bin": persona_bin, "legacy": True})
    deadline = time.monotonic() + daemon_timeout()
    for index, registration in enumerate(registrations):
        repo_dir = registration["repo_dir"]
        try:
            # Give every registered repository a bounded attempt, even when a
            # previous daemon stalls, within the hook's total subprocess budget.
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise ValueError("SessionEnd time budget exhausted; repository registration retained for retry")
            daemon_end(registration["persona_bin"], session_id, repo_dir, remaining / (len(registrations) - index))
            if not registration.get("legacy"):
                remove_session_registration(session_id, repo_dir)
        except (OSError, subprocess.SubprocessError, ValueError) as err:
            errors.append(f"{repo_dir}: {subprocess_error_text(err)}")
    for err in errors:
        print(f"persona daemon end failed during SessionEnd: {err}", file=sys.stderr)
    return 0


def main():
    try:
        event = load_event()
    except (ValueError, OSError) as err:
        print(f"persona hook input failed: {err}", file=sys.stderr)
        return 2
    hook_name = event.get("hook_event_name")
    try:
        if hook_name == "PreToolUse":
            return handle_pretooluse(event)
        if hook_name in {"PostToolUse", "PostToolUseFailure", "PermissionDenied"}:
            return handle_posttooluse(event)
        if hook_name == "SessionEnd":
            return handle_session_end(event)
    except (OSError, subprocess.SubprocessError, ValueError, TypeError) as err:
        reason = f"persona hook preparation failed: {subprocess_error_text(err)}"
        if hook_name == "PreToolUse":
            emit_pretooluse("deny", reason)
        elif hook_name in {"PostToolUse", "PostToolUseFailure", "PermissionDenied"}:
            emit_posttooluse(reason + "; saving is unconfirmed. Preserve the view and lease record for recovery.", hook_name, warning=True)
        else:
            print(reason, file=sys.stderr)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
